# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/bus_stand_app

# JWT
JWT_SECRET=bus_stand_app_jwt_secret_key_min_32_chars_for_production_use
JWT_REFRESH_SECRET=bus_stand_app_refresh_secret_key_min_32_chars_for_prod
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google APIs
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# AI Service
AI_SERVICE_URL=http://localhost:5001

# Firebase Admin (for push notifications)
FIREBASE_ADMIN_CREDENTIALS=./firebase-service-account.json
