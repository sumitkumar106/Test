# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/bus_stand_app
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/bus_stand_app

# JWT
JWT_SECRET=your_secret_key_minimum_32_characters_long_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_minimum_32_characters_long_change_this
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Google APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_GEOCODING_API_KEY=your_geocoding_api_key

# AI Service
AI_SERVICE_URL=http://localhost:5001

# Firebase Admin (for push notifications)
FIREBASE_ADMIN_CREDENTIALS=./firebase-service-account.json
